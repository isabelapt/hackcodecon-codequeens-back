# Google Gemini API
# Gerar chave grátis em: https://aistudio.google.com/apikey
GEMINI_API_KEY=sua_chave_aqui

# MongoDB Atlas (Recomendado - Cloud grátis)
# 1. Criar conta: https://www.mongodb.com/cloud/atlas
# 2. Deploy cluster FREE tier
# 3. Connect → Drivers → Python → copia a connection string
# 4. Cole a connection string abaixo (substitua user:password)
MONGODB_URL=mongodb+srv://seu_user:sua_senha@goosecat.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=goosecat

# ALTERNATIVA: MongoDB local (descomente se usar mongod em localhost)
# MONGODB_URL=mongodb://localhost:27017
# MONGODB_DB=goosecat
FLASK_DEBUG=false
